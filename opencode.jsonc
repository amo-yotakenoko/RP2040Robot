{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "instructions": [
    "AGENTS.md",
    "freecad/OPENCODE_FREECAD.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "watcher": {
    "ignore": [
      "**/*.FCStd",
      "**/*.FCStd1",
      "**/*.FCBak",
      "**/*.blend",
      "**/*.blend1",
      "**/*.blend2",
      "**/*.mp4",
      "**/node_modules/**",
      "**/Library/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
